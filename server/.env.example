# ==============================================================================
# CloudCloset Atelier API Server — Environment Template (server/.env.example)
# DO NOT store real credentials in this template.
# ==============================================================================

PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/cloudcloset
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cloudcloset
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# SSL / TLS Settings (Set to true when connecting to Amazon RDS)
# When true, uses Amazon RDS Root CA (server/src/config/rds-ca-bundle.pem) for verified encryption
DB_SSL=false
# Optional custom CA certificate path:
DB_CA_CERT=
# Set to true only in automated test runner if in-memory emulation is needed:
USE_PG_MEM=false

# Authentication Secrets
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_256bit
JWT_EXPIRES_IN=7d

# API Rate Limiting Controls
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_AUTH=30

# Amazon S3 Storage Configuration
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET_NAME=cloudcloset-atelier-assets-2026
# When deployed to Amazon EC2 with an IAM Instance Profile attached, leave AWS_ACCESS_KEY_ID
# and AWS_SECRET_ACCESS_KEY blank. The AWS SDK v3 default credential chain will automatically
# retrieve temporary credentials securely via the EC2 instance metadata service (IMDSv2).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
