{
  "name": "cloudcloset-server",
  "version": "1.0.0",
  "description": "CloudCloset Atelier Luxury Apparel API Server (Node.js & Express)",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "db:verify": "node src/db/verifyDb.js",
    "s3:migrate": "node scripts/migrateImagesToS3.js",
    "s3:verify": "node scripts/verifyS3Security.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-rds": "^3.1153.0",
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/client-sts": "^3.1153.0",
    "@aws-sdk/s3-request-presigner": "^3.758.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "pg-mem": "^3.0.4",
    "supertest": "^7.0.0",
    "vitest": "^3.0.8"
  }
}
