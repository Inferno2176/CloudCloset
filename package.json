{
  "name": "cloudcloset",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "node server/src/index.js",
    "server": "node server/src/index.js",
    "server:dev": "node --watch server/src/index.js",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "npm --prefix server run test",
    "db:verify": "npm --prefix server run db:verify",
    "s3:migrate": "node server/scripts/migrateImagesToS3.js"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "oxlint": "^1.88.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.17",
    "vite": "^8.3.4"
  }
}
