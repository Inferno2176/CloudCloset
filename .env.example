# ==============================================================================
# CloudCloset — Environment Configuration Template (.env.example)
# IMPORTANT: Copy this file to .env and configure your values.
# NEVER commit .env to source control or expose secret credentials.
# ==============================================================================

# Server Network Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Frontend API Endpoint (Vite)
VITE_API_URL=http://localhost:5001/api

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/cloudcloset
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cloudcloset
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_SSL=false

# Authentication & Security
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_256bit
JWT_EXPIRES_IN=7d

# AWS S3 Storage Configuration
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET_NAME=cloudcloset-atelier-assets-2026
# When deployed to Amazon EC2 with an IAM Instance Profile attached, leave AWS_ACCESS_KEY_ID
# and AWS_SECRET_ACCESS_KEY blank. The AWS SDK v3 default credential chain will automatically
# retrieve temporary credentials securely via the EC2 instance metadata service (IMDSv2).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Frontend S3 Endpoint (if presigned URLs or CloudFront distribution is configured)
VITE_S3_BUCKET_URL=
